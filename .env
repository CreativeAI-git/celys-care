# Database Connection
# PostgreSQL format: postgresql://user:password@localhost:5432/celys_care?schema=public
# SQLite format (for zero-config local dev): file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication sessions
JWT_SECRET="celys_care_super_secret_jwt_key_wellness_2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# RevenueCat In-App Purchases (Google Play & Apple App Store)
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY="goog_placeholder_revenuecat_api_key"
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY="appl_placeholder_revenuecat_api_key"
REVENUECAT_SECRET_API_KEY="sk_placeholder_revenuecat_secret_key"
REVENUECAT_WEBHOOK_SECRET="rc_webhook_secret_placeholder"


