# ==============================================================================
# Celys Care — Production Environment Variables Reference
# ==============================================================================

# Database Connection (PostgreSQL for Production / SQLite file:./dev.db for Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/celys_care?schema=public"

# Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET="celys-care-super-secret-jwt-signing-key-production-32bytes-min!"

# Cryptography — AES-256-GCM Journal Encryption Key (Generate with `openssl rand -hex 32`)
JOURNAL_ENCRYPTION_SECRET="celys-care-aes-256-gcm-vault-master-key-must-be-32bytes!"

# Payment & Subscription Gateway (Stripe)
STRIPE_SECRET_KEY="sk_test_51...your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_...your_stripe_webhook_signing_secret"

# AI Wellness Companion (OpenAI / Google Gemini Compatible API)
AI_API_KEY="sk-proj-...your_ai_api_key_or_leave_blank_for_built_in_synthesizer"
AI_ENDPOINT="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"

# Public Application URL & Environment
NEXT_PUBLIC_APP_URL="https://celyscare.com"
NODE_ENV="production"
